# Copy this file to .env and fill it in. NEVER share or upload your .env.

# --- Where things live (one big drive or NAS share is ideal) ---
CONFIG_DIR=/srv/mediastack/config        # app settings (small, back this up)
DATA_DIR=/srv/mediastack/data            # media + downloads (big)

# --- Your user and timezone ---
PUID=1000                                # run `id` and use your uid
PGID=1000                                # ... and gid
TZ=America/Chicago                       # https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# --- Jellyfin version (pinned; change on purpose to upgrade) ---
JELLYFIN_VERSION=latest                  # e.g. 10.11.11 once you've picked a version you trust

# --- VPN for the download client (see https://github.com/qdm12/gluetun-wiki) ---
VPN_SERVICE_PROVIDER=protonvpn           # protonvpn, mullvad, airvpn, ...
VPN_TYPE=wireguard                       # wireguard (recommended) or openvpn
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=                     # only some providers need this (Mullvad does; ProtonVPN doesn't)
OPENVPN_USER=
OPENVPN_PASSWORD=
VPN_SERVER_COUNTRIES="United States"

# --- Optional remote access (docker compose --profile remote up -d) ---
CLOUDFLARE_TUNNEL_TOKEN=
